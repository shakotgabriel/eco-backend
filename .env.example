# Bebeto Django API — copy to .env and fill in real values.
# Never commit a filled .env.

# ─── Core (required) ───────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1

# First ADMIN (created on boot if the username does not exist yet)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@bebetocoach.com
# DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password

# Postgres in production (SQLite default is for local experiments only)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/bebeto

# ─── Frontends ──────────────────────────────────────────────────
# Comma-separated origins for the customer site + admin portal
CORS_ALLOWED_ORIGINS=https://www.yourdomain.com,https://admin.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com,https://admin.yourdomain.com

# ─── Redis / Celery (required for bookings, payments, throttles) ─
# Local / Compose: set the two URLs below.
# Render: set REDIS_URL only (broker uses /0, cache uses /1).
# REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# ─── Email / SMS ────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=Bebeto Coach <noreply@bebetocoach.com>
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Booking/ticket messages go out on these channels (sms, whatsapp). Unconfigured channels are skipped.
CUSTOMER_NOTIFY_CHANNELS=sms
# Public website, used for the Manage Booking link in messages
PUBLIC_SITE_URL=https://ecobus.co.ss

# ─── MTN MoMo (use sandbox values locally; production credentials for go-live)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_PRIMARY_KEY=
MTN_MOMO_COLLECTION_SECRET=
MTN_MOMO_API_USER=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=UGX
MTN_MOMO_CALLBACK_URL=https://api.yourdomain.com/api/v1/payments/momo/callback/
MTN_MOMO_ALLOWED_IPS=
MTN_MOMO_NOTIFICATION_SECRET=

# MTN MoMo South Sudan (+211, SSP) — separate MTN subscription. +211 MoMo payments stay
# off (customers see "not available yet") until these three are set.
MTN_MOMO_SS_COLLECTION_PRIMARY_KEY=
MTN_MOMO_SS_COLLECTION_SECRET=
MTN_MOMO_SS_API_USER=
# MTN_MOMO_SS_BASE_URL=            (defaults to MTN_MOMO_BASE_URL)
# MTN_MOMO_SS_ENVIRONMENT=mtnsouthsudan
# MTN_MOMO_SS_CURRENCY=SSP
# MTN_MOMO_SS_CALLBACK_URL=        (defaults to MTN_MOMO_CALLBACK_URL)

# ─── M-Pesa Daraja ──────────────────────────────────────────────
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=https://api.yourdomain.com/api/v1/payments/mpesa/callback/
MPESA_ALLOWED_IPS=

# ─── Optional ───────────────────────────────────────────────────
# TICKET_SIGNING_KEY=
# SENTRY_DSN=
# PAYMENT_TIMEOUT_MINUTES=5
